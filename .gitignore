# ---------------------------------------------------------------
# Source data. Rebuilt by tools/build_domain.py from TLC open data.
# Never commit trip parquet -- it is ~300MB and freely downloadable.
# ---------------------------------------------------------------
raw/
*.parquet
*.csv.gz

# ---------------------------------------------------------------
# Warehouse. Rebuilt by the three tools/build_*.py scripts.
# ---------------------------------------------------------------
*.duckdb
*.duckdb.wal
*.db
*.sqlite

# ---------------------------------------------------------------
# Transformation build artefacts
# ---------------------------------------------------------------
transformation/target/
transformation/logs/
transformation/dbt_packages/
transformation/.user.yml
logs/
target/

# ---------------------------------------------------------------
# Local tooling
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.env
.DS_Store
.idea/
.vscode/

# Seed CSVs are project config, not data -- keep them.
!transformation/seeds/*.csv

# ---------------------------------------------------------------
# Operator answer key. Never commit: a session that reads this has
# been told the answer, and the run measures nothing.
# ---------------------------------------------------------------
docs/intents/EVALUATION-NOTES.md
ingestion/.dlt/secrets.toml
